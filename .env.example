# Copy to `.env` and fill in values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Frontend (Vite) — prefix with VITE_ to expose to the browser
# -----------------------------------------------------------------------------
# Use offline coach replies (no API server required)
VITE_COACH_MOCK=false

# Dev server port for Metabuffed (default: 25750)
# PORT=25750

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
# Required when running the API locally (default in npm script: 5000)
# PORT=5000

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Coach LLM (optional — without a key, coach uses knowledge-base fallback)
# Set ONE provider key. OpenAI is checked first, then Anthropic.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision frame fallback (OpenAI image input) — only used if Gemini is not set
# OPENAI_VISION_MODEL=gpt-4o

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# -----------------------------------------------------------------------------
# Temporal video analysis (REQUIRED for real fight watching)
# Gemini watches the full MP4 / public YouTube video and builds an event log.
# Get a key: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.5-flash
# Optional Netlify AI Gateway base URL (auto-injected on Netlify)
# GOOGLE_GEMINI_BASE_URL=

# Max gameplay upload size in megabytes (API server)
UPLOAD_MAX_MB=100

# Optional — improves Twitch oEmbed metadata fetching
# TWITCH_CLIENT_ID=

# -----------------------------------------------------------------------------
# Database (optional — only needed for Drizzle / Postgres features)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/metabuffe
